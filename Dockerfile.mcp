# syntax=docker/dockerfile:1.7
#
# Minimal image for the Scherlok MCP server (scherlok-mcp), intended for
# Glama's MCP server registry check at https://glama.ai/mcp/servers.
#
# The check spins this image up, speaks MCP over stdio, and verifies the
# server responds to `initialize` and `list_tools`. No warehouse connection
# is needed at boot — `SCHERLOK_CONNECTION` is only consulted when a tool
# is actually invoked, so the image is safe to start with no env var set.
#
# The repo's primary `Dockerfile` is geared toward the `scherlok` CLI
# (ENTRYPOINT scherlok) and is published to GHCR for CI use. This file
# is the MCP-server twin: same package, different entry point.

FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Pinning to the published release that first ships scherlok-mcp built-in.
# Bump this when cutting a new minor that changes the tool surface.
RUN pip install --no-cache-dir "scherlok==0.7.0"

# Run as a non-root user so the image is safe to run anywhere.
RUN groupadd --system --gid 1000 scherlok \
    && useradd --system --uid 1000 --gid scherlok --shell /bin/bash --create-home scherlok
USER scherlok
WORKDIR /home/scherlok

ENTRYPOINT ["scherlok-mcp"]
