[3.935, "o", "\u001b[1mScherlok demo\u001b[0m \u2014 a bad deploy, caught before anyone noticed\r\n"]
[3.995, "o", "\r\n"]
[4.055, "o", "\u001b[1m[\u001b[0m\u001b[1;36m1\u001b[0m/\u001b[1;36m4\u001b[0m\u001b[1m]\u001b[0m Seeding a sample warehouse\r\n"]
[4.115, "o", "      \u001b[1;36m3\u001b[0m tables, \u001b[1;36m22\u001b[0m,\u001b[1;36m500\u001b[0m rows \u001b[1m(\u001b[0mDuckDB, temporary\u001b[1m)\u001b[0m\r\n"]
[4.175, "o", "\u001b[1m[\u001b[0m\u001b[1;36m2\u001b[0m/\u001b[1;36m4\u001b[0m\u001b[1m]\u001b[0m \u001b[36mscherlok investigate\u001b[0m \u2014 learning what \u001b[32m\"normal\"\u001b[0m looks like\r\n"]
[4.235, "o", "      \u001b[32m\u2713\u001b[0m orders     \u001b[1;36m20\u001b[0m,\u001b[1;36m000\u001b[0m rows \u00b7 \u001b[1;36m5\u001b[0m columns\r\n"]
[4.295, "o", "      \u001b[32m\u2713\u001b[0m products      \u001b[1;36m500\u001b[0m rows \u00b7 \u001b[1;36m6\u001b[0m columns\r\n"]
[4.355, "o", "      \u001b[32m\u2713\u001b[0m users       \u001b[1;36m2\u001b[0m,\u001b[1;36m000\u001b[0m rows \u00b7 \u001b[1;36m6\u001b[0m columns\r\n"]
[4.415, "o", "      Baseline saved. Nothing fires on a first run: there is nothing to compare against yet.\r\n"]
[5.615, "o", "\u001b[1m[\u001b[0m\u001b[1;36m3\u001b[0m/\u001b[1;36m4\u001b[0m\u001b[1m]\u001b[0m \u001b[1;31m02:14\u001b[0m\u001b[31m AM \u2014 a bad deploy ships\u001b[0m\r\n"]
[6.215, "o", "      \u00b7 orders: the loader stopped after \u001b[1;36m40\u001b[0m% of the nightly batch\r\n"]
[6.565, "o", "      \u00b7 users: a migration nulled e-mails and wrote free-text plans\r\n"]
[6.915, "o", "      \u00b7 products: someone dropped the `category` column\r\n"]
[7.265, "o", "\u001b[1m[\u001b[0m\u001b[1;36m4\u001b[0m/\u001b[1;36m4\u001b[0m\u001b[1m]\u001b[0m \u001b[36mscherlok watch\u001b[0m \u2014 comparing against the baseline\r\n"]
[7.325, "o", "\u001b[3m                                       Detected Anomalies                                       \u001b[0m\r\n"]
[7.725, "o", "\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n"]
[7.785, "o", "\u2503\u001b[1m \u001b[0m\u001b[1mSeverity\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mTable   \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mType              \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mMessage                                          \u001b[0m\u001b[1m \u001b[0m\u2503\r\n"]
[7.845, "o", "\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n"]
[7.905, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;33mWARNING\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36musers   \u001b[0m\u001b[36m \u001b[0m\u2502 null_rate_change   \u2502 Column 'email' NULL rate increased: 0.0% -> 20.0% \u2502\r\n"]
[7.965, "o", "\u2502\u001b[1m          \u001b[0m\u2502\u001b[36m          \u001b[0m\u2502                    \u2502 (\u039420.0%)                                          \u2502\r\n"]
[8.025, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;31mCRITICAL\u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36morders  \u001b[0m\u001b[36m \u001b[0m\u2502 volume_drop        \u2502 Row count dropped 60.0% (20,000 -> 8,000)         \u2502\r\n"]
[8.085, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;31mCRITICAL\u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mproducts\u001b[0m\u001b[36m \u001b[0m\u2502 column_removed     \u2502 Column 'category' was removed                     \u2502\r\n"]
[8.145, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;31mCRITICAL\u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36musers   \u001b[0m\u001b[36m \u001b[0m\u2502 cardinality_change \u2502 Column 'plan' distinct values increased: 5 -> 605 \u2502\r\n"]
[8.205, "o", "\u2502\u001b[1m          \u001b[0m\u2502\u001b[36m          \u001b[0m\u2502                    \u2502 (12000% change)                                   \u2502\r\n"]
[8.265, "o", "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[8.325, "o", "\u001b[1;36m4\u001b[0m anomalies \u001b[1m(\u001b[0m\u001b[1;36m3\u001b[0m critical, \u001b[1;36m1\u001b[0m warning\u001b[1m)\u001b[0m in \u001b[1;36m0.\u001b[0m5s.\r\n"]
[8.385, "o", "In CI, \u001b[36mscherlok ci\u001b[0m would exit \u001b[1;36m1\u001b[0m here and block the deploy.\r\n"]
[8.445, "o", "\r\n"]
[8.505, "o", "\u001b[1mNext: point it at your own database\u001b[0m\r\n"]
[8.565, "o", "  scherlok connect postgres:\u001b[35m/\u001b[0m\u001b[35m/\u001b[0m\u001b[95muser\u001b[0m:pass@host/db\r\n"]
[8.625, "o", "  scherlok investigate\r\n"]
[8.685, "o", "  scherlok watch\r\n"]
[8.745, "o", "\r\n"]
[8.805, "o", "\u001b[2mDemo files removed. Re-run with --keep to explore them.\u001b[0m\r\n"]
[22.865, "o", ""]
