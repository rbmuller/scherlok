[2.93, "o", "Watching \u001b[1;36m2\u001b[0m tables\u001b[33m...\u001b[0m\r\n"]
[2.98, "o", "\u001b[3m                                       Detected Anomalies                                       \u001b[0m\r\n"]
[3.03, "o", "\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n"]
[3.08, "o", "\u2503\u001b[1m \u001b[0m\u001b[1mSeverity\u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mTable    \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mType              \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mMessage                                         \u001b[0m\u001b[1m \u001b[0m\u2503\r\n"]
[3.13, "o", "\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n"]
[3.18, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;33mWARNING\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36morders   \u001b[0m\u001b[36m \u001b[0m\u2502 cardinality_change \u2502 Column 'id' distinct values decreased: 120,000   \u2502\r\n"]
[3.23, "o", "\u2502\u001b[1m          \u001b[0m\u2502\u001b[36m           \u001b[0m\u2502                    \u2502 -> 56,000 (53% change)                           \u2502\r\n"]
[3.28, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;33mWARNING\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36morders   \u001b[0m\u001b[36m \u001b[0m\u2502 cardinality_change \u2502 Column 'amount' distinct values decreased:       \u2502\r\n"]
[3.33, "o", "\u2502\u001b[1m          \u001b[0m\u2502\u001b[36m           \u001b[0m\u2502                    \u2502 120,000 -> 56,000 (53% change)                   \u2502\r\n"]
[3.38, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;31mCRITICAL\u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36mcustomers\u001b[0m\u001b[36m \u001b[0m\u2502 null_rate_change   \u2502 Column 'email' NULL rate increased: 2.0% ->      \u2502\r\n"]
[3.43, "o", "\u2502\u001b[1m          \u001b[0m\u2502\u001b[36m           \u001b[0m\u2502                    \u2502 34.7% (\u039432.7%)                                   \u2502\r\n"]
[3.48, "o", "\u2502\u001b[1m \u001b[0m\u001b[1;31mCRITICAL\u001b[0m\u001b[1m \u001b[0m\u2502\u001b[36m \u001b[0m\u001b[36morders   \u001b[0m\u001b[36m \u001b[0m\u2502 volume_drop        \u2502 Row count dropped 53.3% (120,000 -> 56,000)      \u2502\r\n"]
[3.53, "o", "\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\n"]
[3.58, "o", "\u001b[35m\u256d\u2500\u001b[0m\u001b[35m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[35m \ud83e\udde0 AI hypothesis (--explain) \u001b[0m\u001b[35m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[35m\u2500\u256e\u001b[0m\r\n"]
[3.63, "o", "\u001b[35m\u2502\u001b[0m Both anomalies trace to one upstream event: last night's loader stopped after a partial      \u001b[35m\u2502\u001b[0m\r\n"]
[3.68, "o", "\u001b[35m\u2502\u001b[0m orders batch, so customer enrichment never ran.                                              \u001b[35m\u2502\u001b[0m\r\n"]
[3.73, "o", "\u001b[35m\u2502\u001b[0m                                                                                              \u001b[35m\u2502\u001b[0m\r\n"]
[3.78, "o", "\u001b[35m\u2502\u001b[0m \u001b[1mLikely cause:\u001b[0m The 02:00 ETL run exited early \u2014 orders ingested a partial batch and the step  \u001b[35m\u2502\u001b[0m\r\n"]
[3.83, "o", "\u001b[35m\u2502\u001b[0m that backfills customers.email was skipped.                                                  \u001b[35m\u2502\u001b[0m\r\n"]
[3.88, "o", "\u001b[35m\u2502\u001b[0m \u001b[1mCheck next:\u001b[0m                                                                                  \u001b[35m\u2502\u001b[0m\r\n"]
[3.93, "o", "\u001b[35m\u2502\u001b[0m   1. Check the loader logs around 02:00 UTC for an early exit after the orders step.         \u001b[35m\u2502\u001b[0m\r\n"]
[3.98, "o", "\u001b[35m\u2502\u001b[0m   2. Run `scherlok history --days 7` \u2014 both anomalies should be first-time, not recurring.   \u001b[35m\u2502\u001b[0m\r\n"]
[4.03, "o", "\u001b[35m\u2502\u001b[0m   3. Re-run the enrichment job, then `scherlok watch` to confirm recovery.                   \u001b[35m\u2502\u001b[0m\r\n"]
[4.08, "o", "\u001b[35m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
[8.13, "o", ""]
